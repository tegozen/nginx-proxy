# Скопируйте в app.vhost (только расширение .vhost подхватывается).
# После изменений: docker compose restart nginx
#
# Бэкенд на хосте (localhost): укажите PORT, на который слушает сервис на машине.
# Прокси по умолчанию идёт на host.docker.internal:PORT (см. docker-compose extra_hosts).
# Сервис на хосте лучше слушать 0.0.0.0:PORT, не только 127.0.0.1.

SUBDOMAIN=app
PORT=8080

# Только если бэкенд не на хосте, а в другом контейнере / удалённой машине:
# UPSTREAM_HOST=myservice
# UPSTREAM_HOST=203.0.113.10
# PORT=8080
# Не пишите порт в UPSTREAM_HOST (не 203.0.113.10:8080 — только IP/имя).

# Либо полное имя вместо SUBDOMAIN+BASE_DOMAIN:
# SERVER_NAME=app.example.org
# PORT=3000

# LightRAG и др.: в HTTPS по умолчанию не проксируются пути вроде /webui (остальной / → 403).
# Раскомментируйте, чтобы проксировать весь бэкенд целиком (SSE/OpenAI-compatible API):
# FULL_PROXY=1
#
# Лимит размера тела запроса (по умолчанию nginx: 1m). Пример:
# CLIENT_MAX_BODY_SIZE=50m
